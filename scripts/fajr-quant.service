[Unit]
Description=Fajr-Quant Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/fajrirog/Fajr-Quant
ExecStart=/home/fajrirog/Fajr-Quant/scripts/start.sh
ExecStop=/home/fajrirog/Fajr-Quant/scripts/stop.sh
TimeoutStartSec=300
TimeoutStopSec=120
User=fajrirog
Group=fajrirog

[Install]
WantedBy=multi-user.target
